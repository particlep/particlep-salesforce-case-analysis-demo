# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Data source: "synthetic" or "salesforce" ---
CASE_SOURCE=synthetic

# Required when CASE_SOURCE=salesforce
SF_USERNAME=
SF_PASSWORD=
SF_SECURITY_TOKEN=
SF_DOMAIN=login
# Optional: list view URL prefix for case links in the email
SF_INSTANCE_URL=https://your-domain.lightning.force.com

# --- Email: "sendgrid" or "console" ---
EMAIL_PROVIDER=console

# Required when EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=
EMAIL_FROM=daily-brief@example.com
EMAIL_TO=support-lead@example.com,vp-ops@example.com

# --- Run-mode overrides ---
# Override "yesterday" for backfills or tests; ISO date e.g. 2026-05-10
RUN_DATE=

# Where to write a copy of the rendered HTML even when sending live
OUTPUT_DIR=sample_outputs
